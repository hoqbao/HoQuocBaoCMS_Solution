@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .post-detail-wrapper {
        max-width: 980px;
        margin: 0 auto;
    }

    .post-hero {
        border-radius: 16px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .post-image {
        width: 100%;
        max-height: 420px;
        object-fit: contain;
        background-color: #f8f9fa;
        padding: 12px;
    }

    .post-content-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    .post-title {
        font-size: 32px;
        font-weight: 800;
        color: #212529;
        line-height: 1.3;
    }

    .post-meta {
        color: #6c757d;
        font-size: 14px;
    }

    .post-category {
        display: inline-block;
        background: #e7f1ff;
        color: #0d6efd;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    .post-content {
        font-size: 17px;
        line-height: 1.8;
        color: #343a40;
    }

        .post-content img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
            margin: 12px 0;
        }

        .post-content p {
            margin-bottom: 16px;
        }

    .action-bar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
</style>

<div class="container-fluid py-4">
    <div class="post-detail-wrapper">

        <div class="mb-4 action-bar">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>

            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i> Sửa bài viết
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger"
                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                    <i class="bi bi-trash"></i> Xóa
                </a>
            </div>
        </div>

        <div class="post-content-box mb-4">
            <div class="mb-3">
                @if (Model.Category != null)
                {
                    <span class="post-category">
                        <i class="bi bi-folder2-open"></i> @Model.Category.Name
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Chưa có danh mục
                    </span>
                }
            </div>

            <h1 class="post-title mb-3">
                @Model.Title
            </h1>

            <div class="post-meta mb-4">
                <i class="bi bi-calendar-event"></i>
                Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="post-hero mb-4">
                <img src="@Model.ImageUrl"
                     alt="@Model.Title"
                     class="post-image" />
            </div>
        }

        <div class="post-content-box">
            <h5 class="text-uppercase text-secondary fw-bold mb-3">
                <i class="bi bi-file-text"></i> Nội dung bài viết
            </h5>

            <div class="post-content">
                @Html.Raw(Model.Content)
            </div>
        </div>

    </div>
</div>