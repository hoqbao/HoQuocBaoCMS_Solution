@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chi tiết bài viết";
}

<div class="container mt-4">
    <h2 class="text-primary">@Model.Title</h2>

    <p class="text-muted">
        Ngày đăng: @Model.CreatedDate.ToString("dd/MM/yyyy")
    </p>

    @if (Model.Category != null)
    {
        <span class="badge bg-info text-dark mb-3">
            @Model.Category.Name
        </span>
    }
    else
    {
        <span class="badge bg-secondary mb-3">
            Chưa có danh mục
        </span>
    }

    <div class="mt-3">
        <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="Thumbnail" />
    </div>

    <div class="mt-4">
        <p>@Model.Content</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>
</div>