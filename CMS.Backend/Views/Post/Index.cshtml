@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<style>
    .post-thumbnail {
        width: 100%;
        height: 220px;
        object-fit: cover;
        object-position: center;
    }

    .card {
        border-radius: 10px;
        overflow: hidden;
    }
</style>

<div class="container mt-4">
    <h2 class="mb-4 text-danger">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>

    <a href="/Post/Create" class="btn btn-primary mb-3">
        Thêm bài viết mới
    </a>

    <div class="row">
        @foreach (var post in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100 shadow-sm">
                    <img src="@post.ImageUrl" class="card-img-top post-thumbnail" alt="Thumbnail" />

                    <div class="card-body">
                        @if (post.Category != null)
                        {
                            <span class="badge bg-info text-dark">
                                @post.Category.Name
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Chưa có danh mục
                            </span>
                        }

                        <h5 class="card-title text-primary mt-2">
                            @post.Title
                        </h5>

                        <p class="card-text text-truncate">
                            @post.Content
                        </p>

                        <p class="text-muted small">
                            Ngày đăng: @post.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <a href="/Post/Details/@post.Id" class="btn btn-outline-primary btn-sm">
                            Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>