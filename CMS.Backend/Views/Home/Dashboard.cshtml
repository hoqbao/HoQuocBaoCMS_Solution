@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "_LayoutAdmin";
}

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Danh mục</h5>
                <h2>@ViewBag.TotalCategories</h2>
                <p class="card-text">Tổng số danh mục</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Bài viết</h5>
                <h2>@ViewBag.TotalPosts</h2>
                <p class="card-text">Tổng số bài viết</p>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5 class="card-title">Thành viên</h5>
                <h2>@ViewBag.TotalUsers</h2>
                <p class="card-text">Tổng số thành viên</p>
            </div>
        </div>
    </div>
</div>