@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var latestPosts = ViewBag.LatestPosts as List<CMS.Data.Entities.Post>;
    var latestProducts = ViewBag.LatestProducts as List<CMS.Data.Entities.Product>;
}

<style>
    .dashboard-title {
        font-weight: 800;
        color: #212529;
    }

    .dashboard-subtitle {
        color: #6c757d;
        font-size: 15px;
    }

    .stat-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
        transition: 0.2s ease-in-out;
        background: #ffffff;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
        }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #ffffff;
    }

    .stat-number {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 0;
    }

    .stat-label {
        color: #6c757d;
        font-weight: 600;
        margin-bottom: 0;
    }

    .bg-blue {
        background: linear-gradient(135deg, #0d6efd, #4dabf7);
    }

    .bg-green {
        background: linear-gradient(135deg, #198754, #51cf66);
    }

    .bg-orange {
        background: linear-gradient(135deg, #fd7e14, #ffb347);
    }

    .bg-purple {
        background: linear-gradient(135deg, #6f42c1, #b197fc);
    }

    .bg-red {
        background: linear-gradient(135deg, #dc3545, #ff6b6b);
    }

    .bg-darkblue {
        background: linear-gradient(135deg, #0b7285, #22b8cf);
    }

    .quick-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .quick-link {
        text-decoration: none;
        color: #212529;
        display: block;
        padding: 14px 16px;
        border-radius: 12px;
        transition: 0.2s ease-in-out;
        background: #f8f9fa;
        margin-bottom: 10px;
        font-weight: 600;
    }

        .quick-link:hover {
            background: #e7f1ff;
            color: #0d6efd;
            transform: translateX(4px);
        }

    .table-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .welcome-box {
        border-radius: 18px;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        padding: 28px;
        box-shadow: 0 10px 28px rgba(13, 110, 253, 0.25);
    }
</style>

<div class="container-fluid">
    <div class="welcome-box mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2 class="mb-2 fw-bold">
                    <i class="bi bi-speedometer2"></i> Bảng điều khiển quản trị
                </h2>

                <p class="mb-0">
                    Tổng quan hệ thống CMS, sản phẩm, khách hàng và đơn hàng.
                </p>
            </div>

            <div class="text-end mt-3 mt-md-0">
                <div class="small opacity-75">Xin chào</div>
                <h5 class="mb-0">
                    @User.FindFirst("FullName")?.Value
                </h5>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Danh mục bài viết</p>
                        <p class="stat-number">@ViewBag.TotalCategories</p>
                    </div>

                    <div class="stat-icon bg-blue">
                        <i class="bi bi-grid"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Bài viết</p>
                        <p class="stat-number">@ViewBag.TotalPosts</p>
                    </div>

                    <div class="stat-icon bg-green">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Thành viên</p>
                        <p class="stat-number">@ViewBag.TotalUsers</p>
                    </div>

                    <div class="stat-icon bg-purple">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Danh mục sản phẩm</p>
                        <p class="stat-number">@ViewBag.TotalProductCategories</p>
                    </div>

                    <div class="stat-icon bg-orange">
                        <i class="bi bi-tags"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Sản phẩm</p>
                        <p class="stat-number">@ViewBag.TotalProducts</p>
                    </div>

                    <div class="stat-icon bg-darkblue">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Khách hàng</p>
                        <p class="stat-number">@ViewBag.TotalCustomers</p>
                    </div>

                    <div class="stat-icon bg-blue">
                        <i class="bi bi-person-badge"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Đơn hàng</p>
                        <p class="stat-number">@ViewBag.TotalOrders</p>
                    </div>

                    <div class="stat-icon bg-red">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card stat-card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="stat-label">Chi tiết đơn hàng</p>
                        <p class="stat-number">@ViewBag.TotalOrderDetails</p>
                    </div>

                    <div class="stat-icon bg-green">
                        <i class="bi bi-card-list"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card quick-card">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-lightning-charge text-warning"></i> Thao tác nhanh
                    </h5>

                    <a asp-controller="Post" asp-action="Create" class="quick-link">
                        <i class="bi bi-plus-circle"></i> Thêm bài viết mới
                    </a>

                    <a asp-controller="Product" asp-action="Create" class="quick-link">
                        <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
                    </a>

                    <a asp-controller="Category" asp-action="Create" class="quick-link">
                        <i class="bi bi-folder-plus"></i> Thêm danh mục bài viết
                    </a>

                    <a asp-controller="User" asp-action="Create" class="quick-link">
                        <i class="bi bi-person-plus"></i> Thêm thành viên
                    </a>

                    <a asp-controller="Home" asp-action="Index" class="quick-link">
                        <i class="bi bi-house"></i> Xem trang chủ MVC
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card table-card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-file-earmark-text text-primary"></i> Bài viết mới nhất
                    </h5>
                </div>

                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tiêu đề</th>
                                <th>Ngày đăng</th>
                                <th style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (latestPosts != null && latestPosts.Any())
                            {
                                foreach (var post in latestPosts)
                                {
                                    <tr>
                                        <td>
                                            <strong>@post.Title</strong>
                                        </td>

                                        <td>
                                            @post.CreatedDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            <a asp-controller="Post"
                                               asp-action="Details"
                                               asp-route-id="@post.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Xem
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        Chưa có bài viết nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card table-card">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-box-seam text-success"></i> Sản phẩm mới nhất
                    </h5>
                </div>

                <div class="card-body p-0">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tên sản phẩm</th>
                                <th>Giá bán</th>
                                <th>Tồn kho</th>
                                <th style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (latestProducts != null && latestProducts.Any())
                            {
                                foreach (var product in latestProducts)
                                {
                                    <tr>
                                        <td>
                                            <strong>@product.Name</strong>
                                        </td>

                                        <td class="text-danger fw-bold">
                                            @product.Price.ToString("N0") đ
                                        </td>

                                        <td>
                                            @product.StockQuantity
                                        </td>

                                        <td>
                                            <a asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Sửa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        Chưa có sản phẩm nào.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>