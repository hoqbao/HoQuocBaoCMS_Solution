@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Trang chủ";
}

<style>
    .home-post-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        object-position: center;
    }

    .home-post-card {
        border-radius: 10px;
        overflow: hidden;
    }
</style>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-danger">
        TIN TỨC MỚI NHẤT
    </h2>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100 home-post-card">
                    <img src="@item.ImageUrl" class="card-img-top home-post-img" alt="Thumbnail" />

                    <div class="card-body">
                        @if (item.Category != null)
                        {
                            <span class="badge bg-primary mb-2">
                                @item.Category.Name
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary mb-2">
                                Chưa có danh mục
                            </span>
                        }

                        <h5 class="card-title">
                            @item.Title
                        </h5>

                        <p class="card-text text-truncate">
                            @item.Content
                        </p>

                        <a href="/Post/Details/@item.Id" class="btn btn-outline-danger btn-sm">
                            Đọc tiếp
                        </a>
                    </div>

                    <div class="card-footer text-muted small">
                        Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        }
    </div>
</div>