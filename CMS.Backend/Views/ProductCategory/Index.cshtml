@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #198754, #0d6efd);
        color: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(25, 135, 84, 0.25);
    }

    .category-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .category-table th {
        background-color: #212529;
        color: white;
        vertical-align: middle;
    }

    .category-table td {
        vertical-align: middle;
    }

    .empty-box {
        padding: 42px;
        text-align: center;
        color: #6c757d;
    }

    .action-buttons {
        white-space: nowrap;
    }
</style>

<div class="container-fluid">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-tags"></i> DANH MỤC SẢN PHẨM
                </h2>

                <p class="mb-0">
                    Quản lý các nhóm sản phẩm như đầm dạ hội, đồ nam công sở, phụ kiện nam.
                </p>
            </div>

            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="bi bi-plus-circle"></i> Thêm danh mục sản phẩm
                </a>
            </div>
        </div>
    </div>

    <div class="card category-card">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul text-success"></i> Danh sách danh mục sản phẩm
                    </h5>

                    <small class="text-muted">
                        Dữ liệu lấy từ bảng CategoriesProducts trong SQL Server
                    </small>
                </div>

                <span class="badge bg-success px-3 py-2 mt-2 mt-md-0">
                    Tổng: @Model.Count() danh mục
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 category-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 80px;">ID</th>
                                <th>Tên danh mục</th>
                                <th>Mô tả</th>
                                <th class="text-center" style="width: 190px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-success">
                                        #@item.Id
                                    </td>

                                    <td>
                                        <strong>
                                            <i class="bi bi-tag text-success"></i>
                                            @item.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <span class="text-muted">@item.Description</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Chưa có mô tả</span>
                                        }
                                    </td>

                                    <td class="text-center action-buttons">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục sản phẩm này không?')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-tags" style="font-size: 52px;"></i>

                    <h5 class="mt-3">
                        Chưa có danh mục sản phẩm nào
                    </h5>

                    <p>
                        Hãy thêm danh mục sản phẩm đầu tiên để quản lý cửa hàng.
                    </p>

                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Thêm danh mục sản phẩm
                    </a>
                </div>
            }
        </div>
    </div>
</div>