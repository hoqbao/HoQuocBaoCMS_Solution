@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #dc3545, #fd7e14);
        color: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(220, 53, 69, 0.25);
    }

    .main-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .data-table th {
        background-color: #212529;
        color: white;
        vertical-align: middle;
    }

    .data-table td {
        vertical-align: middle;
    }

    .empty-box {
        padding: 42px;
        text-align: center;
        color: #6c757d;
    }

    .status-badge {
        font-size: 13px;
        padding: 7px 12px;
        border-radius: 20px;
    }
</style>

<div class="container-fluid">
    <div class="page-header mb-4">
        <div>
            <h2 class="mb-1 fw-bold">
                <i class="bi bi-receipt"></i> QUẢN LÝ ĐƠN HÀNG
            </h2>

            <p class="mb-0">
                Theo dõi danh sách đơn hàng, khách hàng đặt mua và trạng thái xử lý.
            </p>
        </div>
    </div>

    <div class="card main-card">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul text-danger"></i> Danh sách đơn hàng
                    </h5>

                    <small class="text-muted">
                        Dữ liệu lấy từ bảng Orders trong SQL Server
                    </small>
                </div>

                <span class="badge bg-danger px-3 py-2 mt-2 mt-md-0">
                    Tổng: @Model.Count() đơn hàng
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 data-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 80px;">ID</th>
                                <th>Khách hàng</th>
                                <th>Ngày đặt</th>
                                <th>Trạng thái</th>
                                <th>Ghi chú</th>
                                <th class="text-center" style="width: 190px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-danger">
                                        #@item.Id
                                    </td>

                                    <td>
                                        @if (item.Customer != null)
                                        {
                                            <strong>@item.Customer.FullName</strong>
                                            <br />
                                            <small class="text-muted">@item.Customer.Phone</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có khách hàng</span>
                                        }
                                    </td>

                                    <td>
                                        <i class="bi bi-calendar-event"></i>
                                        @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @if (item.Status == 0)
                                        {
                                            <span class="badge bg-warning text-dark status-badge">
                                                Chờ duyệt
                                            </span>
                                        }
                                        else if (item.Status == 1)
                                        {
                                            <span class="badge bg-primary status-badge">
                                                Đang giao
                                            </span>
                                        }
                                        else if (item.Status == 2)
                                        {
                                            <span class="badge bg-success status-badge">
                                                Đã xong
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary status-badge">
                                                Không rõ
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            @item.Notes
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Không có ghi chú</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a asp-controller="OrderDetail"
                                           asp-action="Index"
                                           asp-route-orderId="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này không?')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-receipt" style="font-size: 52px;"></i>
                    <h5 class="mt-3">Chưa có đơn hàng nào</h5>
                    <p>Đơn hàng sẽ xuất hiện sau khi khách hàng đặt mua sản phẩm.</p>
                </div>
            }
        </div>
    </div>
</div>