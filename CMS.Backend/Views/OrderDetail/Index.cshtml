@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #0b7285, #6610f2);
        color: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(11, 114, 133, 0.25);
    }

    .main-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .data-table th {
        background-color: #212529;
        color: white;
        vertical-align: middle;
    }

    .data-table td {
        vertical-align: middle;
    }

    .empty-box {
        padding: 42px;
        text-align: center;
        color: #6c757d;
    }

    .money-text {
        color: #dc3545;
        font-weight: 800;
    }
</style>

<div class="container-fluid">
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-card-list"></i> CHI TIẾT ĐƠN HÀNG
                </h2>

                <p class="mb-0">
                    Theo dõi sản phẩm, số lượng và đơn giá trong từng đơn hàng.
                </p>
            </div>

            <div class="mt-3 mt-md-0">
                <a asp-controller="Order" asp-action="Index" class="btn btn-light fw-bold">
                    <i class="bi bi-arrow-left"></i> Quay lại đơn hàng
                </a>
            </div>
        </div>
    </div>

    <div class="card main-card">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul text-info"></i> Danh sách chi tiết đơn hàng
                    </h5>

                    <small class="text-muted">
                        Dữ liệu lấy từ bảng OrderDetails trong SQL Server
                    </small>
                </div>

                <span class="badge bg-info text-dark px-3 py-2 mt-2 mt-md-0">
                    Tổng: @Model.Count() dòng chi tiết
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 data-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 80px;">ID</th>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                                <th class="text-center" style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                var total = item.Quantity * item.UnitPrice;

                                <tr>
                                    <td class="text-center fw-bold text-info">
                                        #@item.Id
                                    </td>

                                    <td>
                                        <span class="badge bg-dark">
                                            Đơn #@item.OrderId
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.Order?.Customer != null)
                                        {
                                            <strong>@item.Order.Customer.FullName</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có khách hàng</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Product != null)
                                        {
                                            <strong>@item.Product.Name</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có sản phẩm</span>
                                        }
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td class="money-text">
                                        @item.UnitPrice.ToString("N0") đ
                                    </td>

                                    <td class="money-text">
                                        @total.ToString("N0") đ
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa dòng chi tiết này không?')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-card-list" style="font-size: 52px;"></i>
                    <h5 class="mt-3">Chưa có chi tiết đơn hàng nào</h5>
                    <p>Dữ liệu chi tiết sẽ xuất hiện khi đơn hàng có sản phẩm.</p>
                </div>
            }
        </div>
    </div>
</div>