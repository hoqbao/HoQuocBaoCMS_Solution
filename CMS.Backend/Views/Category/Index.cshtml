@model IEnumerable<CMS.Data.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .category-page-title {
        font-weight: 800;
        color: #212529;
    }

    .category-subtitle {
        color: #6c757d;
        font-size: 15px;
    }

    .category-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .category-table th {
        background-color: #212529;
        color: #ffffff;
        vertical-align: middle;
        font-weight: 600;
    }

    .category-table td {
        vertical-align: middle;
    }

    .category-id {
        width: 70px;
        text-align: center;
        font-weight: 700;
        color: #0d6efd;
    }

    .category-name {
        font-weight: 700;
        color: #212529;
    }

    .category-description {
        color: #6c757d;
        max-width: 520px;
    }

    .action-buttons {
        white-space: nowrap;
    }

    .empty-box {
        padding: 40px;
        text-align: center;
        color: #6c757d;
    }

    .top-action-box {
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        color: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(13, 110, 253, 0.25);
    }
</style>

<div class="container-fluid">
    <div class="top-action-box mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2 class="mb-1">
                    <i class="bi bi-grid"></i> QUẢN LÝ DANH MỤC BÀI VIẾT
                </h2>

                <p class="mb-0">
                    Quản lý các nhóm chủ đề bài viết như thời trang, công sở, phụ kiện, xu hướng...
                </p>
            </div>

            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="bi bi-plus-circle"></i> Thêm danh mục mới
                </a>
            </div>
        </div>
    </div>

    <div class="card category-card">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul text-primary"></i> Danh sách danh mục
                    </h5>
                    <small class="text-muted">
                        Dữ liệu được lấy trực tiếp từ bảng Categories trong SQL Server
                    </small>
                </div>

                <span class="badge bg-primary px-3 py-2">
                    Tổng: @Model.Count() danh mục
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 category-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 80px;">ID</th>
                                <th>Tên danh mục</th>
                                <th>Mô tả</th>
                                <th class="text-center" style="width: 190px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="category-id">
                                        #@item.Id
                                    </td>

                                    <td>
                                        <div class="category-name">
                                            <i class="bi bi-folder2-open text-warning"></i>
                                            @item.Name
                                        </div>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="category-description">
                                                @item.Description
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">
                                                Chưa có mô tả
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center action-buttons">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-folder-x" style="font-size: 48px;"></i>
                    <h5 class="mt-3">Chưa có danh mục nào</h5>
                    <p>Hãy thêm danh mục đầu tiên để bắt đầu quản lý bài viết.</p>

                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Thêm danh mục mới
                    </a>
                </div>
            }
        </div>
    </div>
</div>