@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">
                <i class="bi bi-pencil-square"></i> SỬA SẢN PHẨM
            </h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Danh mục sản phẩm</label>
                            <select asp-for="CategoryProductId"
                                    asp-items="ViewBag.CategoryProductList"
                                    class="form-select">
                                <option value="0">-- Chọn danh mục sản phẩm --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Giá bán</label>
                            <input asp-for="Price"
                                   type="number"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng tồn kho</label>
                            <input asp-for="StockQuantity"
                                   type="number"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh hiện tại</label>
                            <br />

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl"
                                     class="img-thumbnail mb-2"
                                     style="width: 180px; height: 130px; object-fit: cover;" />
                            }
                            else
                            {
                                <p class="text-muted">Chưa có ảnh</p>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn ảnh mới nếu muốn thay đổi</label>
                            <input type="file"
                                   name="uploadImage"
                                   class="form-control"
                                   accept="image/*" />
                        </div>
                    </div>
                </div>

                <hr />

                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Cập nhật sản phẩm
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </form>
        </div>
    </div>
</div>