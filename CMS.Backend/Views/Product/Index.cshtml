@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .product-page-header {
        background: linear-gradient(135deg, #198754, #0d6efd);
        color: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(25, 135, 84, 0.25);
    }

    .product-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .product-table th {
        background-color: #212529;
        color: white;
        vertical-align: middle;
        font-weight: 600;
    }

    .product-table td {
        vertical-align: middle;
    }

    .product-image {
        width: 110px;
        height: 90px;
        object-fit: contain;
        background-color: #f8f9fa;
        padding: 6px;
        border-radius: 10px;
        border: 1px solid #dee2e6;
    }

    .product-name {
        font-weight: 800;
        color: #212529;
    }

    .product-description {
        color: #6c757d;
        font-size: 14px;
        max-width: 420px;
    }

    .price-text {
        color: #dc3545;
        font-weight: 800;
        font-size: 16px;
    }

    .stock-badge {
        font-size: 13px;
        padding: 7px 12px;
        border-radius: 20px;
    }

    .category-badge {
        font-size: 13px;
        padding: 7px 10px;
    }

    .action-buttons {
        white-space: nowrap;
    }

    .empty-box {
        padding: 42px;
        text-align: center;
        color: #6c757d;
    }
</style>

<div class="container-fluid">
    <div class="product-page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2 class="mb-1 fw-bold">
                    <i class="bi bi-box-seam"></i> QUẢN LÝ SẢN PHẨM
                </h2>

                <p class="mb-0">
                    Quản lý sản phẩm thời trang, giá bán, tồn kho, hình ảnh và danh mục sản phẩm.
                </p>
            </div>

            <div class="mt-3 mt-md-0">
                <a asp-action="Create" class="btn btn-light fw-bold">
                    <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
                </a>
            </div>
        </div>
    </div>

    <div class="card product-card">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-list-ul text-success"></i> Danh sách sản phẩm
                    </h5>

                    <small class="text-muted">
                        Dữ liệu được lấy trực tiếp từ bảng Products trong SQL Server
                    </small>
                </div>

                <span class="badge bg-success px-3 py-2 mt-2 mt-md-0">
                    Tổng: @Model.Count() sản phẩm
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0 product-table">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 70px;">ID</th>
                                <th class="text-center" style="width: 140px;">Hình ảnh</th>
                                <th>Sản phẩm</th>
                                <th style="width: 180px;">Danh mục</th>
                                <th style="width: 140px;">Giá bán</th>
                                <th style="width: 120px;">Tồn kho</th>
                                <th class="text-center" style="width: 210px;">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-success">
                                        #@item.Id
                                    </td>

                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.Name"
                                                 class="product-image" />
                                        }
                                        else
                                        {
                                            <div class="text-muted small">
                                                <i class="bi bi-image"></i>
                                                <br />
                                                Chưa có ảnh
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="product-name mb-1">
                                            @item.Name
                                        </div>

                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <div class="product-description">
                                                @{
                                                    var desc = item.Description;
                                                    if (desc.Length > 130)
                                                    {
                                                        desc = desc.Substring(0, 130) + "...";
                                                    }
                                                }

                                                @desc
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">
                                                Chưa có mô tả
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.CategoryProduct != null)
                                        {
                                            <span class="badge bg-info text-dark category-badge">
                                                <i class="bi bi-tags"></i> @item.CategoryProduct.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary category-badge">
                                                Chưa có danh mục
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="price-text">
                                            @item.Price.ToString("N0") đ
                                        </span>
                                    </td>

                                    <td>
                                        @if (item.StockQuantity > 10)
                                        {
                                            <span class="badge bg-success stock-badge">
                                                @item.StockQuantity còn hàng
                                            </span>
                                        }
                                        else if (item.StockQuantity > 0)
                                        {
                                            <span class="badge bg-warning text-dark stock-badge">
                                                @item.StockQuantity sắp hết
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger stock-badge">
                                                Hết hàng
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center action-buttons">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?')">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-box">
                    <i class="bi bi-box-seam" style="font-size: 52px;"></i>

                    <h5 class="mt-3">
                        Chưa có sản phẩm nào
                    </h5>

                    <p>
                        Hãy thêm sản phẩm đầu tiên để bắt đầu quản lý cửa hàng thời trang.
                    </p>

                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
                    </a>
                </div>
            }
        </div>
    </div>
</div>