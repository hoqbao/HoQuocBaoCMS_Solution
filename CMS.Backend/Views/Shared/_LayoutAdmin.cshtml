<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ThaiCMS Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        body {
            background-color: #f5f6fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .admin-wrapper {
            min-height: 100vh;
        }

        .sidebar {
            min-height: 100vh;
            background: linear-gradient(180deg, #212529, #111827);
            color: white;
            position: sticky;
            top: 0;
        }

        .sidebar-brand {
            padding: 22px 18px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        }

        .sidebar-brand h4 {
            font-weight: 800;
            margin-bottom: 4px;
        }

        .sidebar-brand span {
            font-size: 13px;
            color: #adb5bd;
        }

        .sidebar-menu {
            padding: 14px 10px;
        }

        .sidebar-menu a {
            color: #ced4da;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 16px;
            margin-bottom: 6px;
            border-radius: 10px;
            transition: all 0.2s ease-in-out;
            font-weight: 500;
        }

        .sidebar-menu a:hover {
            background-color: rgba(13, 110, 253, 0.18);
            color: #ffffff;
            transform: translateX(4px);
        }

        .sidebar-menu i {
            font-size: 17px;
        }

        .menu-divider {
            border-color: rgba(255, 255, 255, 0.16);
            margin: 14px 8px;
        }

        .admin-topbar {
            background-color: #ffffff;
            border-radius: 14px;
            padding: 16px 22px;
            margin-bottom: 24px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
        }

        .topbar-title {
            font-size: 20px;
            font-weight: 800;
            color: #212529;
            margin-bottom: 0;
        }

        .topbar-subtitle {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 0;
        }

        .user-pill {
            background-color: #f1f5ff;
            color: #0d6efd;
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 700;
            font-size: 14px;
        }

        .content-area {
            padding: 24px;
        }

        .btn-logout {
            border-radius: 999px;
            font-weight: 600;
        }

        @@media (max-width: 768px) {
            .sidebar {
                min-height: auto;
                position: static;
            }

            .content-area {
                padding: 16px;
            }

            .admin-topbar {
                display: block !important;
                text-align: center;
            }

            .topbar-actions {
                margin-top: 12px;
                justify-content: center !important;
            }
        }
    </style>
</head>

<body>
    <div class="container-fluid admin-wrapper">
        <div class="row">

            <!-- SIDEBAR -->
            <nav class="col-md-3 col-lg-2 sidebar p-0">
                <div class="sidebar-brand">
                    <h4>
                        <i class="bi bi-shield-lock"></i> QuocBaoMS
                    </h4>
                    <span>Admin Management</span>
                </div>

                <div class="sidebar-menu">
                    <a asp-controller="Home" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        <span>Bảng điều khiển</span>
                    </a>

                    <a asp-controller="Category" asp-action="Index">
                        <i class="bi bi-grid"></i>
                        <span>Quản lý Danh mục</span>
                    </a>

                    <a asp-controller="Post" asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Quản lý Bài viết</span>
                    </a>

                    <a asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i>
                        <span>Quản lý Thành viên</span>
                    </a>

                    <hr class="menu-divider" />

                    <a asp-controller="ProductCategory" asp-action="Index">
                        <i class="bi bi-tags"></i>
                        <span>Danh mục sản phẩm</span>
                    </a>

                    <a asp-controller="Product" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        <span>Sản phẩm</span>
                    </a>

                    <a asp-controller="Customer" asp-action="Index">
                        <i class="bi bi-person-badge"></i>
                        <span>Khách hàng</span>
                    </a>

                    <a asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt"></i>
                        <span>Đơn hàng</span>
                    </a>

                    <a asp-controller="OrderDetail" asp-action="Index">
                        <i class="bi bi-card-list"></i>
                        <span>Chi tiết đơn hàng</span>
                    </a>

                    <hr class="menu-divider" />

                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i>
                        <span>Về trang chủ</span>
                    </a>
                </div>
            </nav>

            <!-- MAIN CONTENT -->
            <main class="col-md-9 col-lg-10 content-area">

                <!-- TOP NAVBAR -->
                <div class="admin-topbar d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="topbar-title">
                            @ViewData["Title"]
                        </h5>

                        <p class="topbar-subtitle">
                            Hệ thống quản trị nội dung và bán hàng thời trang
                        </p>
                    </div>

                    <div class="topbar-actions d-flex align-items-center gap-2">
                        <span class="user-pill">
                            <i class="bi bi-person-circle"></i>
                            @User.FindFirst("FullName")?.Value
                        </span>

                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="btn btn-outline-danger btn-sm btn-logout">
                            <i class="bi bi-box-arrow-right"></i>
                            Đăng xuất
                        </a>
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>