@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Quên mật khẩu - QuocBaoCMS Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #005580, #12b886);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .forgot-card {
            width: 100%;
            max-width: 460px;
            background-color: #ffffff;
            border-radius: 22px;
            padding: 34px;
            box-shadow: 0 18px 46px rgba(0, 0, 0, 0.18);
        }

        .forgot-icon {
            width: 66px;
            height: 66px;
            margin: 0 auto 18px;
            border-radius: 18px;
            background: linear-gradient(135deg, #005580, #12b886);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        .forgot-title {
            text-align: center;
            color: #005580;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .forgot-subtitle {
            text-align: center;
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 26px;
        }

        .form-label {
            font-weight: 800;
            color: #344054;
        }

        .form-control {
            height: 46px;
            border-radius: 12px;
        }

        .btn-reset {
            width: 100%;
            height: 46px;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, #005580, #12b886);
            color: #ffffff;
            font-weight: 900;
        }

            .btn-reset:hover {
                color: #ffffff;
                filter: brightness(1.05);
            }

        .temporary-password-box {
            margin-top: 18px;
            padding: 16px;
            border-radius: 14px;
            background-color: #e7f8f3;
            border: 1px solid #b6f0de;
            color: #0b6b4f;
            font-weight: 700;
        }

        .temporary-password {
            display: block;
            margin-top: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            background-color: #ffffff;
            color: #005580;
            font-size: 20px;
            font-weight: 900;
            text-align: center;
            letter-spacing: 1px;
        }

        .back-login {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #005580;
            font-weight: 800;
            text-decoration: none;
        }

            .back-login:hover {
                color: #12b886;
            }
    </style>
</head>
<body>
    <div class="forgot-card">
        <div class="forgot-icon">
            <i class="bi bi-key"></i>
        </div>

        <h2 class="forgot-title">Quên mật khẩu</h2>

        <p class="forgot-subtitle">
            Nhập tên đăng nhập để hệ thống tạo mật khẩu tạm thời.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i>
                @ViewBag.Error
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle"></i>
                @ViewBag.Success
            </div>

            <div class="temporary-password-box">
                Tài khoản: <strong>@ViewBag.Username</strong>
                <br />
                Mật khẩu tạm thời của bạn là:

                <span class="temporary-password">
                    @ViewBag.TemporaryPassword
                </span>

                <small class="d-block mt-2 text-muted">
                    Vui lòng dùng mật khẩu này để đăng nhập lại.
                </small>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label" for="username">Tên đăng nhập</label>
                <input id="username"
                       name="username"
                       type="text"
                       class="form-control"
                       placeholder="Nhập username của bạn" />
            </div>

            <button type="submit" class="btn btn-reset">
                <i class="bi bi-arrow-clockwise"></i>
                Đặt lại mật khẩu
            </button>
        </form>

        <a asp-controller="Account" asp-action="Login" class="back-login">
            <i class="bi bi-arrow-left"></i>
            Quay lại đăng nhập
        </a>
    </div>
</body>
</html>